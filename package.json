{
  "name": "sitenura",
  "private": true,
  "description": "Sitenura: turns non-technical intent into expert prompts with a planner LLM, then executes them with Claude.",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @sitenura/api prisma:migrate",
    "db:studio": "pnpm --filter @sitenura/api prisma:studio"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3"
  }
}
