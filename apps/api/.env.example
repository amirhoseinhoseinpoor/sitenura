NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Matches docker-compose.yml defaults
DATABASE_URL=postgresql://sitenura:sitenura@localhost:5432/sitenura?schema=public

# LLM providers (used from Phase 2 onwards)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
