NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Matches docker-compose.yml defaults
DATABASE_URL=postgresql://sitenura:sitenura@localhost:5432/sitenura?schema=public

# LLM providers. Each provider is enabled only when its API key is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# Per-attempt timeout and retry count for LLM calls
LLM_TIMEOUT_MS=300000
LLM_MAX_RETRIES=2
