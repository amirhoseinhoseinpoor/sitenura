// PromptBridge data model.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum InteractionMode {
  BASIC
  ADVANCED
}

enum PlannerProvider {
  OPENAI
  GEMINI
  ANTHROPIC
}

enum ProjectStatus {
  DRAFT
  PLANNING
  EXECUTING
  COMPLETED
  FAILED
}

enum PromptChunkStatus {
  PENDING
  PLANNED
  EXECUTING
  DONE
  FAILED
}

/// A website the user is building through PromptBridge.
model Project {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @db.VarChar(120)
  mode            InteractionMode
  plannerProvider PlannerProvider @default(OPENAI) @map("planner_provider")
  status          ProjectStatus   @default(DRAFT)

  /// Answers collected by the BASIC wizard (colors, template, pages, ...).
  requirements Json @default("{}")

  chunks PromptChunk[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("projects")
}

/// One ordered piece of work: the planner turns user intent into a prompt,
/// then the executor (Claude) runs it.
model PromptChunk {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @map("project_id") @db.Uuid
  order     Int
  title     String            @db.VarChar(200)
  status    PromptChunkStatus @default(PENDING)

  /// Raw intent sent to the planner LLM.
  userIntent     String  @map("user_intent") @db.Text
  /// Expert prompt produced by the planner LLM.
  plannedPrompt  String? @map("planned_prompt") @db.Text
  /// Output returned by the executor (Claude).
  executorOutput String? @map("executor_output") @db.Text

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, order])
  @@map("prompt_chunks")
}
